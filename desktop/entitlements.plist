<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Marginalia.app's own entitlements: only V8's JIT (needed under the hardened runtime that a signing identity
     turns on). No camera, microphone, location, photos, Bluetooth, USB or printing: the page is denied all of them. -->
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
