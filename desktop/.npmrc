# No package runs an install script: a general guard (none of the pinned packages has one; electron 45 dropped its
# postinstall and instead downloads its binary into node_modules the first time plain Node runs require("electron"),
# which nothing in desktop/ does: the build packages the Electron it downloads into .cache/electron, and the tests
# never load electron). `npm run app` still runs its own script.
ignore-scripts=true
save-exact=true
fund=false
